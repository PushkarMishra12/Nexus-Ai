# Demo mode uses durable local JSON storage. Set DATABASE_URL to use PostgreSQL.
PORT=4173
NODE_ENV=development
DATA_FILE=./data/nexusai.json
DATABASE_URL=
PGSSL=false
SESSION_TTL_HOURS=12
DEMO_MODE=true

# Optional OpenAI-compatible chat completions endpoint. When unset, the transparent
# rule-based sample-data analyst is used.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
